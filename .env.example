DATABASE_URL="postgresql://schedule:schedule@localhost:5433/schedule"
SESSION_SECRET="replace-with-a-random-32-byte-hex-string"

# Optional: leave both unset to keep email codes printed to the server
# console (dev default). Set both to send real email via Resend
# (resend.com) — RESEND_FROM_EMAIL must be on a domain verified in your
# Resend dashboard (SPF/DKIM DNS records added there), e.g.
# "Schedule.az <noreply@schedule.az>".
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Optional: leave all three unset to keep phone OTP codes printed to the
# server console (dev default). Set all three to send real SMS via a
# self-hosted Jasmin gateway (github.com/jookies/jasmin) through its HTTP
# API plugin. JASMIN_HTTP_URL is the base URL only, no trailing /send, e.g.
# "http://jasmin-host:1401".
JASMIN_HTTP_URL=""
JASMIN_USERNAME=""
JASMIN_PASSWORD=""

# Public origin, used to build links in reminder messages (booking pages,
# the reminder stop link). Defaults to https://schedule.az if unset.
NEXT_PUBLIC_SITE_URL=""

# Appointment and win-back reminders run on an in-process loop that starts
# with the server (src/instrumentation.ts). Set to "1" to turn that loop
# off, e.g. when running a one-off script or a second process.
REMINDERS_DISABLED=""

# Optional bearer token for POST /api/cron/run-reminders, an external
# trigger for the same reminder cycle the loop runs. Unset means the route
# returns 404 and only the in-process loop runs.
CRON_SECRET=""
