generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per identity (phone or email), global across every store. This is
// what lets a single consumer account carry favorites/bookings across every
// store later, and is also the login identity for store admins/staff (role
// lives on StoreMember, not here).
// Phone is the default identity (matches how local businesses operate, and
// is what SMS reminders are sent to). Email is a fallback identity for
// people without an Azerbaijani number — mainly tourists booking as
// consumers. Exactly one of phone/email is guaranteed at the application
// layer (see requestOtp in lib/otp.ts); Postgres doesn't enforce "at least
// one of two nullable columns" without a raw CHECK constraint, which isn't
// worth the extra migration complexity at this scale.
model User {
  id        String   @id @default(cuid())
  phone     String?  @unique
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())

  memberships StoreMember[]
  bookings    Booking[]
  favorites   Favorite[]
  otpCodes    OtpCode[]
}

enum StoreMemberRole {
  ADMIN
  STAFF
}

// Tenant = Store. Every tenant-owned row below carries storeId.
model Store {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  description String?
  // Logo bytes live on disk (storage/logos/{id}), not in Postgres or a
  // logoUrl column — see src/app/api/logos/[storeId]/route.ts. logoUpdatedAt
  // doubles as a cache-busting query param for the served image URL.
  logoMimeType   String?
  logoUpdatedAt  DateTime?
  address     String?
  latitude    Float?
  longitude   Float?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  StoreMember[]
  services Service[]
  bookings Booking[]
  favorites Favorite[]

  @@index([category])
}

// Join of a User to a Store with a role. Role is checked per-store, which is
// how "admin can edit everything, staff sees only their own calendar" is
// enforced — a person can be ADMIN at one store and STAFF at another.
model StoreMember {
  id      String          @id @default(cuid())
  storeId String
  userId  String
  role    StoreMemberRole

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  availability StaffAvailability[]
  exceptions   AvailabilityException[]
  bookingsAsStaff Booking[] @relation("BookingStaff")

  @@unique([storeId, userId])
  @@index([storeId])
  @@index([userId])
}

model Service {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  durationMin Int
  // Null means "price discussed in store" — the admin can choose not to
  // list a fixed price.
  priceAzn    Decimal? @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([storeId])
}

// Weekly recurring working hours for one staff member. dayOfWeek 0 = Sunday.
model StaffAvailability {
  id            String @id @default(cuid())
  storeMemberId String
  dayOfWeek     Int
  startMinute   Int // minutes since midnight, e.g. 09:00 = 540
  endMinute     Int

  storeMember StoreMember @relation(fields: [storeMemberId], references: [id], onDelete: Cascade)

  @@unique([storeMemberId, dayOfWeek])
}

enum AvailabilityExceptionType {
  BUSY // e.g. a specific holiday, a one-off day off
  FREE // reopens a date that would otherwise be closed
}

// One-off or annually-repeating overrides on top of the weekly pattern in
// StaffAvailability, e.g. "closed the week of Novruz every year" or "off
// this specific Thursday." startDate/endDate are stored as UTC midnight,
// inclusive on both ends. When recurringAnnually is true, the year on both
// dates is ignored at query time, only month+day are compared, so one row
// covers every year without needing to be recreated.
model AvailabilityException {
  id                String                     @id @default(cuid())
  storeMemberId     String
  startDate         DateTime
  endDate           DateTime
  type              AvailabilityExceptionType
  recurringAnnually Boolean                    @default(false)
  label             String?
  createdAt         DateTime                   @default(now())

  storeMember StoreMember @relation(fields: [storeMemberId], references: [id], onDelete: Cascade)

  @@index([storeMemberId])
}

enum OtpPurpose {
  LOGIN
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  purpose   OtpPurpose
  codeHash  String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

enum BookingStatus {
  PENDING_CONFIRMATION // waiting on consumer to confirm via OTP
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

model Booking {
  id            String        @id @default(cuid())
  storeId       String
  serviceId     String
  storeMemberId String // the staff member booked
  userId        String // the consumer
  startAt       DateTime
  endAt         DateTime
  status        BookingStatus @default(PENDING_CONFIRMATION)
  note          String?
  // The actual amount charged, entered by staff/admin when marking a
  // booking COMPLETED. This is what revenue analytics are computed from,
  // deliberately not Service.priceAzn, which is just the listed price and
  // can differ from what a customer was actually charged (discounts,
  // upsells, "discussed in store" services with no listed price at all).
  priceAzn      Decimal?      @db.Decimal(10, 2)
  // Set whenever a customer reschedules, so staff can tell "new request"
  // from "moved request" in their queue instead of the two looking identical.
  rescheduledAt DateTime?
  // Null means the customer hasn't seen this status yet. Set on creation
  // (they obviously know they just booked), cleared back to null whenever
  // staff/admin accepts or declines, and set again once the customer
  // actually views it in their account, that's the whole notification.
  clientSeenStatusAt DateTime? @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  storeMember StoreMember @relation("BookingStaff", fields: [storeMemberId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeMemberId, startAt])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
}
