generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per identity (phone or email), global across every store. This is
// what lets a single consumer account carry favorites/bookings across every
// store later, and is also the login identity for store admins/staff (role
// lives on StoreMember, not here).
// Phone is the default identity (matches how local businesses operate, and
// is what SMS reminders are sent to). Email is a fallback identity for
// people without an Azerbaijani number — mainly tourists booking as
// consumers. Exactly one of phone/email is guaranteed at the application
// layer (see requestOtp in lib/otp.ts); Postgres doesn't enforce "at least
// one of two nullable columns" without a raw CHECK constraint, which isn't
// worth the extra migration complexity at this scale.
model User {
  id              String    @id @default(cuid())
  phone           String?   @unique
  email           String?   @unique
  name            String?
  createdAt       DateTime  @default(now())
  // Null until the Instagram-style profile-setup step runs, which every
  // login redirects a user through until it's set (see redirectForUser in
  // src/app/login/actions.ts). Stored lowercase; avatar bytes live on disk
  // (storage/avatars/{id}), same pattern as Store.logoMimeType.
  username        String?   @unique
  avatarMimeType  String?
  avatarUpdatedAt DateTime?

  // Appointment reminders are transactional and always sent. This flag only
  // suppresses the promotional "time to come back" win-back reminders, and
  // is set by the one-tap stop link carried in every win-back message (see
  // src/lib/unsubscribe.ts).
  winbackOptOut Boolean @default(false)

  memberships StoreMember[]
  bookings    Booking[]
  favorites   Favorite[]
  otpCodes    OtpCode[]
  reviews     Review[]
  reminders   ScheduledReminder[]
}

enum StoreMemberRole {
  ADMIN
  STAFF
}

// Tenant = Store. Every tenant-owned row below carries storeId.
model Store {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  category        String
  description     String?
  // Logo bytes live on disk (storage/logos/{id}), not in Postgres or a
  // logoUrl column — see src/app/api/logos/[storeId]/route.ts. logoUpdatedAt
  // doubles as a cache-busting query param for the served image URL.
  logoMimeType    String?
  logoUpdatedAt   DateTime?
  address         String?
  latitude        Float?
  longitude       Float?
  phone           String?
  // Where a customer who leaves a 4-5 star in-app rating gets sent to post
  // it publicly (e.g. a "g.page/r/.../review" link) — see Review below.
  // Null means the review flow just thanks them without a redirect.
  googleReviewUrl String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members   StoreMember[]
  services  Service[]
  bookings  Booking[]
  favorites Favorite[]
  images    StoreImage[]
  reviews   Review[]
  reminders ScheduledReminder[]

  @@index([category])
}

// Gallery photos shown cycling on the directory homepage card, distinct from
// the single logoMimeType/logoUpdatedAt pair above. Bytes live on disk at
// storage/store-images/{storeId}/{id} — see
// src/app/api/store-images/[storeId]/[imageId]/route.ts. position is a plain
// integer sort key the admin reorders by drag; ties broken by createdAt.
model StoreImage {
  id        String   @id @default(cuid())
  storeId   String
  mimeType  String
  position  Int
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, position])
}

// Join of a User to a Store with a role. Role is checked per-store, which is
// how "admin can edit everything, staff sees only their own calendar" is
// enforced — a person can be ADMIN at one store and STAFF at another.
model StoreMember {
  id      String          @id @default(cuid())
  storeId String
  userId  String
  role    StoreMemberRole

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  availability    StaffAvailability[]
  exceptions      AvailabilityException[]
  bookingsAsStaff Booking[]               @relation("BookingStaff")

  @@unique([storeId, userId])
  @@index([storeId])
  @@index([userId])
}

model Service {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  durationMin Int
  // Null means "price discussed in store" — the admin can choose not to
  // list a fixed price.
  priceAzn    Decimal? @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([storeId])
}

// Weekly recurring working hours for one staff member. dayOfWeek 0 = Sunday.
model StaffAvailability {
  id            String @id @default(cuid())
  storeMemberId String
  dayOfWeek     Int
  startMinute   Int // minutes since midnight, e.g. 09:00 = 540
  endMinute     Int

  storeMember StoreMember @relation(fields: [storeMemberId], references: [id], onDelete: Cascade)

  @@unique([storeMemberId, dayOfWeek])
}

enum AvailabilityExceptionType {
  BUSY // e.g. a specific holiday, a one-off day off
  FREE // reopens a date that would otherwise be closed
}

// One-off or annually-repeating overrides on top of the weekly pattern in
// StaffAvailability, e.g. "closed the week of Novruz every year" or "off
// this specific Thursday." startDate/endDate are stored as UTC midnight,
// inclusive on both ends. When recurringAnnually is true, the year on both
// dates is ignored at query time, only month+day are compared, so one row
// covers every year without needing to be recreated.
model AvailabilityException {
  id                String                    @id @default(cuid())
  storeMemberId     String
  startDate         DateTime
  endDate           DateTime
  type              AvailabilityExceptionType
  recurringAnnually Boolean                   @default(false)
  label             String?
  createdAt         DateTime                  @default(now())

  storeMember StoreMember @relation(fields: [storeMemberId], references: [id], onDelete: Cascade)

  @@index([storeMemberId])
}

enum OtpPurpose {
  LOGIN
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  // Wrong-code guesses against this row. Locked out at MAX_VERIFY_ATTEMPTS
  // (see src/lib/otp.ts) so a 6-digit code can't be brute-forced during its
  // 10-minute validity window; the identifier-level 3-per-10min send limit
  // still governs how many fresh codes/lockouts an attacker can churn through.
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

enum SecurityEventType {
  OTP_VERIFY_FAILED
  OTP_LOCKED
  LOGIN_SUCCESS
  STAFF_ADDED
  STAFF_REMOVED
  PERMISSION_DENIED
}

// Queryable trail for the auth/admin events worth investigating after the
// fact (credential-stuffing bursts, who added/removed a staff member).
// Deliberately flat and denormalized (no FK to User/Store) so a row survives
// even if the account or store it references gets deleted later.
model SecurityEvent {
  id        String            @id @default(cuid())
  type      SecurityEventType
  userId    String?
  storeId   String?
  detail    String?
  createdAt DateTime          @default(now())

  @@index([type, createdAt])
  @@index([userId])
}

enum BookingStatus {
  PENDING_CONFIRMATION // waiting on consumer to confirm via OTP
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

model Booking {
  id                 String        @id @default(cuid())
  storeId            String
  serviceId          String
  storeMemberId      String // the staff member booked
  userId             String // the consumer
  startAt            DateTime
  endAt              DateTime
  status             BookingStatus @default(PENDING_CONFIRMATION)
  note               String?
  // The actual amount charged, entered by staff/admin when marking a
  // booking COMPLETED. This is what revenue analytics are computed from,
  // deliberately not Service.priceAzn, which is just the listed price and
  // can differ from what a customer was actually charged (discounts,
  // upsells, "discussed in store" services with no listed price at all).
  priceAzn           Decimal?      @db.Decimal(10, 2)
  // Set whenever a customer reschedules, so staff can tell "new request"
  // from "moved request" in their queue instead of the two looking identical.
  rescheduledAt      DateTime?
  // Null means the customer hasn't seen this status yet. Set on creation
  // (they obviously know they just booked), cleared back to null whenever
  // staff/admin accepts or declines, and set again once the customer
  // actually views it in their account, that's the whole notification.
  clientSeenStatusAt DateTime?     @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  service     Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  storeMember StoreMember         @relation("BookingStaff", fields: [storeMemberId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders   ScheduledReminder[]

  @@index([storeId])
  @@index([storeMemberId, startAt])
  @@index([userId])
  // Planning scans for the most recent completed visit per customer to arm
  // win-back reminders; this keeps that groupBy from a full table scan.
  @@index([status, endAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
}

// A star rating every reviewer leaves in-app first, before anything goes
// anywhere else (see src/lib/reviews.ts for the routing rule). A rating of
// 4-5 gets forwarded to the store's googleReviewUrl for a public review —
// message stays null, since the actual written review lives on Google
// instead. A rating of 1-3 keeps `message` here, visible only to that
// store's admins (src/app/admin/[slug]/reviews), never surfaced publicly,
// so a bad experience reaches the owner without ever touching the public
// rating surface on Google. The numeric rating itself is still counted in
// this store's own average/count everywhere in this app (directory sort,
// filter, store detail) regardless of which path it took — only the public
// Google side is gated, not our own displayed rating.
model Review {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  rating    Int
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
}

enum ReminderKind {
  APPOINTMENT // morning-of nudge before a confirmed booking (transactional)
  WINBACK // "time to come back" nudge, cadence per business type (promotional)
}

enum ReminderChannel {
  SMS
  EMAIL
}

enum ReminderStatus {
  PENDING // due to send once sendAt passes
  SENDING // claimed by a worker run; a reaper requeues rows left stuck here
  SENT
  FAILED // gave up after MAX_ATTEMPTS provider errors
  SKIPPED // rules said don't send (opted out, customer already rebooked, no channel)
  CANCELLED // the booking it belonged to was cancelled/declined/moved
}

// The whole reminder pipeline is planned and sent by the background job
// (src/lib/reminders/*), not by the booking mutation actions — the planner
// re-derives what should exist from Booking state on every run, so it
// self-heals and there are no send hooks scattered across the codebase.
//
// dedupeKey is the idempotency anchor: "appt:<bookingId>" for APPOINTMENT,
// "winback:<userId>:<storeId>" for WINBACK. There is never more than one
// outstanding WINBACK per customer+store; each completed visit re-arms that
// single row, and sending it does not re-arm without a new visit.
model ScheduledReminder {
  id        String          @id @default(cuid())
  kind      ReminderKind
  channel   ReminderChannel
  status    ReminderStatus  @default(PENDING)
  dedupeKey String          @unique

  userId    String
  storeId   String
  // Set for APPOINTMENT, null for WINBACK.
  bookingId String?

  sendAt   DateTime
  // Snapshot of what this reminder was armed against: the booking's startAt
  // for APPOINTMENT (so a reschedule is detected and sendAt moved), or the
  // completed visit's endAt for WINBACK (so a newer visit re-arms it).
  sourceAt DateTime

  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, sendAt])
  @@index([userId, kind, sentAt])
}
